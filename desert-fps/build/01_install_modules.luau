	for index, part in parts do
		part.CollisionGroup = Config.DebrisGroup
		part.CanCollide = true
		part.CanQuery = false
		part.CanTouch = false
		if index > 1 then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = first
			weld.Part1 = part
			weld.Parent = part
		end
