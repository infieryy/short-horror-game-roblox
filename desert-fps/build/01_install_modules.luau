for _, entry in SCRIPTS do
	local parent: Instance = game:GetService(entry.path[1])
	for i = 2, #entry.path - 1 do
		local folder = parent:FindFirstChild(entry.path[i])
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = entry.path[i]
			folder.Parent = parent
		end
		parent = folder
	end
	local name = entry.path[#entry.path]
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local scriptInstance = Instance.new(entry.class)
	scriptInstance.Name = name
	scriptInstance.Source = entry.source
	scriptInstance.Parent = parent
end

game:GetService("ChangeHistoryService"):SetWaypoint("Install Desert FPS scripts")
return #SCRIPTS
