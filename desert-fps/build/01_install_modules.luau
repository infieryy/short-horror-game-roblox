function Ballistics.pace(weapon: any, walking: boolean, aiming: boolean): number
	local speed = weapon.RunSpeed
	if walking then
		speed *= CombatConfig.WalkFactor
	end
	if aiming and weapon.Aim then
		speed *= weapon.Aim.Speed
	end
	return speed
end

return Ballistics
